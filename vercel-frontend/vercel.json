{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    },
    "api/r.js": {
      "maxDuration": 60
    },
    "api/discord-interactions.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/api/auth/:path*"
    },
    {
      "source": "/api/tasks/:id",
      "destination": "/api/r?p=tasks/:id"
    },
    {
      "source": "/api/chat/:room",
      "destination": "/api/r?p=chat/:room"
    },
    {
      "source": "/api/staff-stats/:userId",
      "destination": "/api/r?p=staff-stats/:userId"
    },
    {
      "source": "/api/submissions/:id/:action",
      "destination": "/api/r?p=submissions/:id/:action"
    },
    {
      "source": "/api/staff-requests/:id/:action",
      "destination": "/api/r?p=staff-requests/:id/:action"
    },
    {
      "source": "/api/leave-requests/:id/:action",
      "destination": "/api/r?p=leave-requests/:id/:action"
    },
    {
      "source": "/api/cron/leave-sync",
      "destination": "/api/r?p=cron/leave-sync"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/leave-sync",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/missing-tasks-report",
      "schedule": "59 20 * * *"
    },
    {
      "path": "/api/cron/missing-tasks-report",
      "schedule": "59 21 * * *"
    }
  ]
}
