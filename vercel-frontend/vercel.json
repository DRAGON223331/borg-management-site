{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://replace-with-your-backend.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://replace-with-your-backend.onrender.com/auth/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://replace-with-your-backend.onrender.com/uploads/:path*"
    }
  ]
}
